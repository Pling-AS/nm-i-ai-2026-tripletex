WS_ENDPOINT_HARD=wss://game.ainm.no/ws?token=YOUR_TOKEN
WS_ENDPOINT_EXPERT=wss://game.ainm.no/ws?token=YOUR_TOKEN
WS_ENDPOINT_NIGHTMARE=wss://game.ainm.no/ws?token=YOUR_TOKEN
