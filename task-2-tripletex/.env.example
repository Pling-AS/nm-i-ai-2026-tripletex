# === REQUIRED ===
OPENROUTER_API_KEY=

# === OPTIONAL: Model Configuration ===
# All models default to high-quality options via OpenRouter
OPENROUTER_MODEL=claude-sonnet-4-6
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Multi-model routing (planner + tiered executor)
PLANNER_MODEL=gpt-5.4
PLANNER_FAST_MODEL=claude-sonnet-4-6
TIER1_EXECUTOR_MODEL=claude-sonnet-4-6
TIER2_EXECUTOR_MODEL=claude-opus-4-6
TIER3_EXECUTOR_MODEL=gpt-5.4

# === OPTIONAL: Azure AI (fallback provider for Claude/OpenAI models) ===
# Leave empty to use OpenRouter for everything
AZURE_API_KEY=
AZURE_OPENAI_BASE_URL=
AZURE_ANTHROPIC_BASE_URL=

# === OPTIONAL: Google Cloud Vertex AI (primary Claude backend) ===
# Set VERTEX_AI_PROJECT_ID to enable; leave empty to skip Vertex
VERTEX_AI_ENABLED=false
VERTEX_AI_PROJECT_ID=
VERTEX_AI_REGION=europe-west1
VERTEX_AI_GCLOUD_BIN=gcloud

# === OPTIONAL: PDF Extraction ===
# Datalab Marker API for high-quality PDF extraction (preserves æøå)
# Falls back to pymupdf/pypdf without it
DATALAB_API_KEY=

# === OPTIONAL: Agent Settings ===
AGENT_MAX_STEPS=40
AGENT_MODEL_TEMPERATURE=0.0
HTTP_TIMEOUT_SECONDS=60
MAX_ATTACHMENT_TEXT_CHARS=12000
LOG_LEVEL=INFO

# === OPTIONAL: Endpoint Protection ===
APP_API_KEY=
APP_HOST=0.0.0.0
APP_PORT=8000

# === OPTIONAL: Local Development ===
# For testing against a Tripletex sandbox directly
TRIPLETEX_SANDBOX_LOGIN_EMAIL=
TRIPLETEX_SANDBOX_API_URL=
TRIPLETEX_SANDBOX_API_SESSION_TOKEN=
LOCAL_SOLVE_URL=http://127.0.0.1:8000/solve
