OPENROUTER_API_KEY=
OPENROUTER_MODEL=claude-sonnet-4-6
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Tripletex Accounting Agent

# Azure provider config (fallback for Claude models)
AZURE_API_KEY=
AZURE_OPENAI_BASE_URL=https://magnus-3458-resource.services.ai.azure.com/openai/v1
AZURE_ANTHROPIC_BASE_URL=https://magnus-3458-resource.services.ai.azure.com/anthropic/v1

# Google Cloud Vertex AI (primary backend for Claude models — free on GCP credits)
# Set VERTEX_AI_PROJECT_ID to enable; leave empty to skip Vertex and use Azure/OpenRouter only
VERTEX_AI_ENABLED=true
VERTEX_AI_PROJECT_ID=
VERTEX_AI_REGION=europe-west1
VERTEX_AI_GCLOUD_BIN=gcloud
VERTEX_AI_TOKEN_TTL_SECONDS=3300

# Multi-model routing (planner + tiered executor)
PLANNER_MODEL=gpt-5.4
TIER1_EXECUTOR_MODEL=claude-sonnet-4-6
TIER2_EXECUTOR_MODEL=claude-opus-4-6
TIER3_EXECUTOR_MODEL=gpt-5.4

TRIPLETEX_SANDBOX_LOGIN_EMAIL=
TRIPLETEX_SANDBOX_API_URL=
TRIPLETEX_SANDBOX_API_SESSION_TOKEN=
LOCAL_SOLVE_URL=http://127.0.0.1:8000/solve
APP_API_KEY=
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
AGENT_MAX_STEPS=40
AGENT_MODEL_TEMPERATURE=0.0
HTTP_TIMEOUT_SECONDS=60
MAX_ATTACHMENT_TEXT_CHARS=12000
